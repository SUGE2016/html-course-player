{
  "name": "html-course-player",
  "version": "0.2.0",
  "description": "可复用的离线 HTML 课件播放器与最简示例",
  "author": "Peter XU",
  "license": "MIT",
  "private": true,
  "exports": { "./classroom": "./classroom/dist/index.js" },
  "homepage": "https://github.com/SUGE2016/html-course-player",
  "repository": {
    "type": "git",
    "url": "https://github.com/SUGE2016/html-course-player.git"
  },
  "keywords": [
    "education",
    "slides",
    "html"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node player/serve.cjs --chapter examples/basic --port 4189",
    "build": "tsc -p classroom/tsconfig.json",
    "interactive": "npm run build && node classroom/dist/demo.js",
    "classroom": "npm run build && node classroom/dist/cli.js",
    "test": "node tests/smoke.cjs && node classroom/test_round_controls.cjs && node classroom/test_round_review.cjs",
    "test:classroom": "npm run build && node --test classroom/tests/*.test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
